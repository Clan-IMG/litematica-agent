{
  "schemaVersion": 1,
  "id": "litematica_agent",
  "version": "${version}",
  "name": "Litematica Agent",
  "description": "Autonomous building agent for Litematica schematics.",
  "authors": ["Clan-IMG"],
  "contact": {
    "sources": "https://github.com/Clan-IMG/litematica-agent",
    "issues": "https://github.com/Clan-IMG/litematica-agent/issues"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/litematica_agent/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.clanimg.litematica_agent.LitematicaAgentClient"
    ]
